## Copia este archivo a ".env" y ajusta los valores para tu entorno.
## Nunca subas el archivo ".env" real al repositorio.

# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Base de datos MySQL (bdtupa)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=bdtupa
DB_CONNECTION_LIMIT=10

# Autenticación JWT (panel administrativo)
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Carga de archivos
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
